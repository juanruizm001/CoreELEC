From: CoreELEC Xiaomi SMB3 Multichannel laboratory
Subject: [EXPERIMENTAL R3.1] cifs: mitigate channel loading lag

Incremental follow-up to R3, backporting only:
  66d590b828b1fd9fa337047ae58fe1c4c6f43609
  cifs: deal with the channel loading lag while picking channels

R3 already carries the least-loaded selector derived from:
  ea90708d3cf3d0d92c02afe445ad463fb3c6bf10

Preserve the CoreELEC vendor binding-specific branch. Change only the
non-binding multichannel selector: start the scan from chan_seq, use the
rotated index for least-loaded selection, and reuse the same start position
for the equal-load round-robin fallback.

Deliberately NOT included in R3.1:
  fc43a8ac396d302ced1e991e4913827cf72c8eb9
  79280191c2fd7f24899bbd640003b5389d3c109c
  663c28469d3274d6456f206a6671c91493d85ff1

--- a/fs/cifs/transport.c
+++ b/fs/cifs/transport.c
@@ -1041,7 +1041,7 @@ struct TCP_Server_Info *cifs_pick_channel(struct cifs_ses *ses)
 	uint index = 0;
 	unsigned int min_in_flight = UINT_MAX, max_in_flight = 0;
 	struct TCP_Server_Info *server = NULL;
-	int i;
+	int i, start, cur;
 
 	if (!ses)
 		return NULL;
@@ -1049,8 +1049,10 @@ struct TCP_Server_Info *cifs_pick_channel(struct cifs_ses *ses)
 	spin_lock(&ses->chan_lock);
 	if (!ses->binding) {
 		if (ses->chan_count > 1) {
+			start = atomic_inc_return(&ses->chan_seq);
 			for (i = 0; i < ses->chan_count; i++) {
-				server = ses->chans[i].server;
+				cur = (start + i) % ses->chan_count;
+				server = ses->chans[cur].server;
 				if (!server)
 					continue;
 
@@ -1064,17 +1066,15 @@ struct TCP_Server_Info *cifs_pick_channel(struct cifs_ses *ses)
 				 */
 				if (server->in_flight < min_in_flight) {
 					min_in_flight = server->in_flight;
-					index = i;
+					index = cur;
 				}
 				if (server->in_flight > max_in_flight)
 					max_in_flight = server->in_flight;
 			}
 
 			/* if all channels are equally loaded, fall back to round-robin */
-			if (min_in_flight == max_in_flight) {
-				index = (uint)atomic_inc_return(&ses->chan_seq);
-				index %= ses->chan_count;
-			}
+			if (min_in_flight == max_in_flight)
+				index = (uint)start % ses->chan_count;
 		}
 		spin_unlock(&ses->chan_lock);
 		return ses->chans[index].server;
